# Copy to .env, or run setup_gemini_windows.bat. Keep the real .env off GitHub.
# Free key: https://aistudio.google.com/apikey
AI_ROUTER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=15

# Optional urgent-alert email delivery (SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
